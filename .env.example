# =============================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo como .env y rellena tus valores reales.
# NUNCA subas el archivo .env al repositorio.
# =============================================

# Base de datos MySQL
DB_HOST=tu_host_de_base_de_datos
DB_USER=tu_usuario_de_base_de_datos
DB_PASS=tu_contraseña_de_base_de_datos
DB_NAME=tu_nombre_de_base_de_datos

# Puerto del servidor
PORT=3000

# API Key de Brevo (Sendinblue) para envío de correos
SIB_API_KEY=tu_api_key_de_brevo

# Secreto para firmar JWT (usa una cadena larga y aleatoria)
JWT_SECRET=tu_secreto_jwt_super_seguro

# ID de carpeta en Google Drive (para subida de imágenes)
DRIVE_FOLDER_ID=tu_id_de_carpeta_drive

# Credenciales de MercadoPago
MP_ACCESS_TOKEN=tu_access_token_de_mercadopago
MP_PUBLIC_KEY=tu_public_key_de_mercadopago
